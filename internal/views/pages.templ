package views

import (
	"github.com/matteocontrini/notedimatteo/internal/urls"
	"strconv"
	"time"
)

templ PostPage(page Page, item PostItem) {
	@layout(page) {
		<div class="lg:w-7/12">
			@post(item, true, page.IsLoggedIn)
		</div>
	}
}

// Listing is a page of posts with a heading and the sidebar: categories, tags,
// and months. A zero Pagination shows no pagination.
templ Listing(page Page, heading, emptyMessage string, items []PostItem, p Pagination) {
	@layout(page) {
		<div class="grid gap-20 md:grid-cols-12">
			<div class="md:col-span-7">
				<h2 class="mb-8 text-2xl font-semibold">{ heading }</h2>
				if len(items) == 0 {
					<p class="mt-4 text-slate-500">{ emptyMessage }</p>
				} else {
					for _, item := range items {
						@post(item, true, page.IsLoggedIn)
						<hr class="my-6"/>
					}
				}
				@pagination(p)
			</div>
			@sidebar(page)
		</div>
	}
}

templ Search(page Page, query string, items []PostItem) {
	@layout(page) {
		<div class="grid gap-20 md:grid-cols-12">
			<div class="md:col-span-7">
				if len(items) == 0 || query == "" {
					<h2 class="text-2xl font-semibold">Nessun risultato per "{ query }"</h2>
					<a class="link mt-4 block" href="/">Torna alla home</a>
				} else {
					<h2 class="mb-2 text-2xl font-semibold">
						if len(items) == 1 {
							1 risultato
						} else {
							{ strconv.Itoa(len(items)) } risultati
						}
						per "{ query }"
					</h2>
					<hr class="my-6"/>
					for _, item := range items {
						@post(item, true, page.IsLoggedIn)
						<hr class="my-6"/>
					}
				}
			</div>
			@sidebar(page)
		</div>
	}
}

templ About(page Page) {
	@layout(page) {
		<article class="space-y-4 lg:w-7/12">
			<p>
				Ciao! Sono <a href="https://matteosonoio.it">Matteo Contrini</a> e questo è il mio spazio personale
				dove condivido appunti, idee e segnalazioni sulle cose che mi capita di leggere o di vedere.
			</p>
			<p>
				Non è una newsletter e nemmeno un blog tradizionale. È una specie di archivio, forse un diario,
				nello spirito del Web 1.0: non ci sono notifiche, non ci sono commenti, non ci sono reazioni,
				non ci sono pubblicità. Il design è brutto. Alcune note non hanno nemmeno un titolo. È tutto
				voluto.
			</p>
			<p>
				Scrivimi a <a href="mailto:matteo@notedimatteo.it">matteo@notedimatteo.it</a>.
			</p>
			<p>
				Segui questo spazio con il <a href="/feed.xml">feed RSS</a>.
			</p>
			<p>
				Il codice sorgente di questo sito è su <a href="https://github.com/matteocontrini/notedimatteo">GitHub</a>.
			</p>
		</article>
	}
}

templ Login(page Page, username, message string) {
	@layout(page) {
		<div class="lg:w-7/12">
			<h1 class="mb-6 text-2xl font-semibold">Accedi</h1>
			<form method="post" action="/login" class="space-y-4">
				<div class="flex flex-col gap-2">
					<label class="text-sm font-medium" for="username">Username</label>
					<input
						id="username"
						name="username"
						type="text"
						autocomplete="username"
						required
						value={ username }
						class="h-9"
						autofocus
					/>
				</div>
				<div class="flex flex-col gap-2">
					<label class="text-sm font-medium" for="password">Password</label>
					<input
						id="password"
						name="password"
						type="password"
						autocomplete="current-password"
						required
						class="h-9"
					/>
				</div>
				if message != "" {
					<p class="text-sm text-red-600">{ message }</p>
				}
				<button type="submit" class="h-9 w-full">Accedi</button>
			</form>
		</div>
	}
}

// Unpublished lists the drafts for logged-in users.
templ Unpublished(page Page, items []PostItem) {
	@layout(page) {
		<div class="grid gap-20 md:grid-cols-12">
			<div class="md:col-span-7">
				<h2 class="mb-8 text-2xl font-semibold">Unpublished</h2>
				for _, item := range items {
					@draft(item, time.Now())
					<hr class="my-6"/>
				}
			</div>
			@sidebar(page)
		</div>
	}
}

// draft shows a draft with its dates and its edit and delete controls. Relative
// dates, like "2 days ago", count from now. site.ts asks for confirmation
// before a form with data-confirm submits.
templ draft(item PostItem, now time.Time) {
	<article class="mt-4">
		<header class="space-y-1">
			<div class="text-sm text-slate-500">
				#{ strconv.Itoa(item.Number) } / { item.Title }
				if item.HideTitle {
					(hidden)
				}
			</div>
			<div class="text-sm text-slate-500">
				Created at: { formatDateTime(item.CreatedAt) } ({ relativeTime(item.CreatedAt, now) })
			</div>
			<div class="text-sm text-slate-500">
				Updated at:
				if item.UpdatedAt != nil {
					{ formatDateTime(*item.UpdatedAt) } ({ relativeTime(*item.UpdatedAt, now) })
				} else {
					-
				}
			</div>
			<div class="flex items-center gap-3">
				<a class="text-sm text-slate-500 hover:underline" href={ urls.Edit(item.Number) }>modifica</a>
				<form
					method="post"
					action={ urls.Delete(item.Number) }
					class="inline"
					data-confirm={ "Confirm deletion of post #" + strconv.Itoa(item.Number) + "?" }
				>
					<button type="submit" class="link text-red-600">elimina</button>
				</form>
			</div>
		</header>
		<div class="post-content mt-4">
			@templ.Raw(item.HTML)
		</div>
		<div class="mt-4 flex flex-wrap gap-2">
			for _, tag := range item.Tags {
				<a href={ urls.Tag(tag) }>#{ tag }</a>
			}
		</div>
	</article>
}

// ErrorPage shows an error inside the site layout, like SvelteKit's built-in error page.
templ ErrorPage(page Page, status int, message string) {
	@layout(page) {
		<h1>{ strconv.Itoa(status) }</h1>
		<p>{ message }</p>
	}
}
