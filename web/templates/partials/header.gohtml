{{define "header" -}}
<div class="container mt-6 max-w-6xl">
	<h1 class="text-4xl font-bold">
		<a class="hover:underline" href="/">Note di Matteo</a>
	</h1>

	<div class="mt-4 grid items-center gap-x-20 gap-y-4 lg:grid-cols-12">
		<div class="flex flex-wrap gap-3 lg:col-span-7">
			{{range .Categories}}
				<a
					class="border px-2 py-1 text-sm font-semibold hover:border-slate-700 dark:bg-slate-700 dark:hover:border-slate-300 {{if .Current}}border-slate-700 dark:border-slate-300{{else}}border-slate-300 dark:border-slate-500{{end}}"
					href="{{.URL}}"
				>
					{{.Label}}
					<span class="ml-1 font-normal">{{.Count}}</span>
				</a>
			{{end}}
		</div>

		<form class="lg:col-span-5" method="GET" action="/cerca" role="search">
			<input
				type="search"
				name="q"
				value="{{.SearchQuery}}"
				placeholder="Cerca..."
				aria-label="Cerca nel sito"
				class="h-9 w-full"
			/>
		</form>
	</div>
</div>
{{- end}}
