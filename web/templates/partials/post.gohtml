{{define "post" -}}
<article class="mt-4" data-category="{{.Category}}">
	{{if and .Title (not .HideTitle)}}
		<div>
			<h3 class="inline font-semibold">{{.Title}}</h3>
		</div>
	{{end}}

	<div class="post-content mt-4">{{.HTML}}</div>

	<div class="mt-4 flex flex-wrap gap-2 text-sm">
		<a href="{{postURL .Number .Slug}}">#{{.Number}}</a>
		/
		{{if .ShowDate}}
			<div class="text-slate-500">{{date .Timestamp}}</div>
			/
		{{end}}
		<div class="text-slate-500">{{time .Timestamp}}</div>

		{{with .Tags}}
			/
			{{range .}}
				<a href="{{tagURL .}}">#{{.}}</a>
			{{end}}
		{{end}}

		{{if .CanEdit}}
			/
			<a href="{{editURL .Number}}" class="text-slate-500 hover:underline">modifica</a>
		{{end}}
	</div>
</article>
{{- end}}
