{
	"include": ["web", "scripts", "tests", "*.ts", "*.js"],
	"exclude": ["web/dist"],
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"sourceMap": true
	}
}
