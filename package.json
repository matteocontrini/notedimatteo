{
	"name": "notedimatteo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"generate-migration": "prisma migrate dev --create-only",
		"migrate": "prisma migrate deploy",
		"check-updates": "npx npm-check-updates -i --format group,repo --cooldown 1d"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"dotenv": "^16.4.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^6.16.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/auto-instrumentations-node": "^0.82.0",
		"@opentelemetry/sdk-node": "^0.300.0",
		"@prisma/client": "^6.16.2",
		"@prisma/instrumentation": "^6.16.2",
		"fast-xml-parser": "^5.11.2",
		"fuse.js": "^7.5.0",
		"import-in-the-middle": "^3.5.2",
		"mdast-util-gfm-strikethrough": "^2.0.1",
		"micromark-extension-gfm-strikethrough": "^2.1.0",
		"mode-watcher": "^1.1.0",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sharp": "^0.35.5",
		"sveltekit-superforms": "^3.0.0",
		"timeago.js": "^4.0.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.6.7"
	}
}
