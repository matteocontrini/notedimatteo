{
	"name": "notedimatteo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "go tool templ generate && npm run assets && npm run libvips && set -a && . ./.env && set +a && PKG_CONFIG_LIBDIR=\"$PWD/.libvips\" go run ./cmd/server",
		"migrate": "set -a && . ./.env && set +a && go run ./cmd/migrate",
		"assets": "vite build",
		"libvips": "node scripts/libvips.mjs",
		"test": "vitest run",
		"test:go": "npm run libvips && PKG_CONFIG_LIBDIR=\"$PWD/.libvips\" go test ./...",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"check-updates": "npx npm-check-updates -i --format group,repo --cooldown 1d"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@img/sharp-libvips-dev": "1.3.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"fuse.js": "^7.5.0"
	},
	"optionalDependencies": {
		"@img/sharp-libvips-darwin-arm64": "1.3.4",
		"@img/sharp-libvips-linux-arm64": "1.3.4",
		"@img/sharp-libvips-linux-x64": "1.3.4"
	}
}
