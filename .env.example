DATABASE_PATH=notedimatteo.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
